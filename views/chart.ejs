<!doctype html>
<html lang="en">
  <%- include('partials/head', { title: 'Nockmarket — Chart', extraStylesheets: ['/vendor/uplot/uPlot.min.css'] }) %>
  <body>
    <%- include('partials/nav', { username: typeof username !== 'undefined' ? username : null, active: 'chart', csrfToken }) %>

    <main class="container">
      <hgroup>
        <h1>Trade History</h1>
        <p>Recent trades for a selected symbol.</p>
      </hgroup>

      <label for="stock-select">Symbol</label>
      <select id="stock-select">
        <% symbols.forEach(function (sym) { %>
        <option value="<%= sym %>"><%= sym %></option>
        <% }) %>
      </select>

      <p id="chart-error" class="form-errors" role="alert"></p>
      <div id="chart-container" class="chart-container"></div>
    </main>

    <script type="module" src="/js/chart.js"></script>
  </body>
</html>
