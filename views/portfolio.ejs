<!doctype html>
<html lang="en">
  <%- include('partials/head', { title: 'Nockmarket — Portfolio' }) %>
  <body>
    <%- include('partials/nav', { username, active: 'portfolio', csrfToken }) %>

    <main class="container">
      <hgroup>
        <h1>Welcome to the Nockmarket</h1>
        <p>Here you can manage your portfolio and view live prices.</p>
      </hgroup>

      <nav class="tabs" role="tablist">
        <button
          type="button"
          role="tab"
          id="tab-btn-portfolio"
          data-tab="tab-portfolio"
          aria-selected="true"
        >
          Portfolio
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-market"
          data-tab="tab-market"
          aria-selected="false"
        >
          Nockmarket
        </button>
        <button type="button" role="tab" id="tab-btn-chat" data-tab="tab-chat" aria-selected="false">
          Chat
        </button>
        <button
          type="button"
          role="tab"
          id="tab-btn-account"
          data-tab="tab-account"
          aria-selected="false"
        >
          My Account
        </button>
      </nav>

      <section id="tab-portfolio" role="tabpanel" aria-labelledby="tab-btn-portfolio">
        <form id="add-stock-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <fieldset role="group">
            <input
              id="stock-input"
              type="text"
              name="stock"
              placeholder="Symbol, e.g. NOCK1"
              list="known-symbols"
              autocomplete="off"
              required
            />
            <input
              id="volume-input"
              type="number"
              name="volume"
              placeholder="Shares"
              min="1"
              step="1"
              value="1"
            />
            <button type="submit">Add Stock</button>
          </fieldset>
        </form>
        <datalist id="known-symbols">
          <% symbols.forEach(function (sym) { %>
          <option value="<%= sym %>"></option>
          <% }) %>
        </datalist>
        <p id="add-stock-errors" class="form-errors" role="alert"></p>

        <label for="filter-input">Filter</label>
        <input id="filter-input" type="text" placeholder="Filter by symbol" autocomplete="off" />

        <table>
          <thead>
            <tr>
              <th scope="col">Stock Code</th>
              <th scope="col">Volume</th>
              <th scope="col">Last Price</th>
            </tr>
          </thead>
          <tbody id="portfolio-body">
            <% portfolio.forEach(function (holding) { %>
            <tr data-stock="<%= holding.stock %>">
              <th scope="row"><%= holding.stock %></th>
              <td><%= holding.volume %></td>
              <td>
                <%= holding.price === null ? '—' : holding.price.toFixed(2) %>
                <% if (holding.stale) { %>
                <small>(stale)</small>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>

      <section id="tab-market" role="tabpanel" aria-labelledby="tab-btn-market" hidden>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Stock</th>
                <th scope="col">Bid 5</th>
                <th scope="col">Bid 4</th>
                <th scope="col">Bid 3</th>
                <th scope="col">Bid 2</th>
                <th scope="col">Bid 1</th>
                <th scope="col">Trade</th>
                <th scope="col">Ask 1</th>
                <th scope="col">Ask 2</th>
                <th scope="col">Ask 3</th>
                <th scope="col">Ask 4</th>
                <th scope="col">Ask 5</th>
              </tr>
            </thead>
            <tbody id="market-body"></tbody>
          </table>
        </div>
      </section>

      <section id="tab-chat" role="tabpanel" aria-labelledby="tab-btn-chat" hidden>
        <button type="button" id="join-chat">Join Chat</button>
        <div id="chat-widget" hidden>
          <div id="chat-log" class="chat-log" role="log" aria-live="polite"></div>
          <form id="chat-form">
            <fieldset role="group">
              <input
                id="chat-message"
                type="text"
                placeholder="Enter your message"
                autocomplete="off"
              />
              <button type="submit">Send</button>
            </fieldset>
          </form>
          <p><strong>Online:</strong> <span id="chat-users" class="chat-users"></span></p>
        </div>
      </section>

      <section id="tab-account" role="tabpanel" aria-labelledby="tab-btn-account" hidden>
        <form id="account-form">
          <label for="email-input">Email</label>
          <fieldset role="group">
            <input id="email-input" type="email" name="email" value="<%= email %>" required />
            <button type="submit">Update</button>
          </fieldset>
        </form>
        <p id="account-status" role="status"></p>
      </section>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script type="module" src="/js/portfolio.js"></script>
  </body>
</html>
