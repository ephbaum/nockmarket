{
  "name": "nockmarket",
  "version": "1.0.0",
  "description": "A simulated stock exchange and portfolio web app.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "test:integration": "node --test \"test/**/*.integration.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@picocss/pico": "^2",
    "connect-mongo": "^6.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.5.0",
    "pino": "^9",
    "pino-http": "^10",
    "socket.io": "^4.8.3",
    "uplot": "^1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
