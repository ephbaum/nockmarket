# Copy this file to .env and it works as-is for local development:
#   cp .env.example .env && npm run dev
# No value below is required to get a working dev setup. See the
# "Contract" section of README.md for the full type/default/required
# table and for the Socket.IO events and market payload shape.

# --- Server -----------------------------------------------------------

# TCP port the HTTP + Socket.IO server listens on.
PORT=3000

# development | production | test. Controls cookie `secure`, error
# verbosity, and whether SESSION_SECRET is required (see below).
NODE_ENV=development

# Number of reverse-proxy hops to trust (Express `trust proxy`), or
# `false` to trust none. Leave false for local/dev; set to `1` when
# running behind a single reverse proxy (e.g. in production) so
# `secure` cookies and rate limiting see the real client IP.
TRUST_PROXY=false

# --- Database -----------------------------------------------------------

# mongodb:// connection string. This default matches `docker compose up`
# and a locally-running `mongod` on the default port.
MONGODB_URI=mongodb://localhost:27017/nockmarket

# --- Sessions -------------------------------------------------------------

# Secret used to sign the session cookie.
#   - In production this is REQUIRED; the app fails fast at startup if
#     it is unset.
#   - In development, if left blank, the app generates an ephemeral
#     secret at startup and logs a loud warning (sessions won't survive
#     a restart). That's fine for local work; set a real value here if
#     you want sessions to persist across restarts.
SESSION_SECRET=

# Set to true to accept legacy unsalted-MD5 password hashes at login
# (upgrading them to scrypt on successful verification). This app ships
# with no legacy users, so it is safe to leave on; flip to false once
# you are certain no MD5 hashes remain in your users collection — after
# that, affected accounts must reset their password.
LEGACY_MD5_LOGIN=true

# --- Quotes ---------------------------------------------------------------

# Which quote provider to use: fake | stooq. `fake` needs no network
# and no key, and is deterministic (same symbol + time bucket always
# yields the same price), which is what keeps `docker compose up`
# working offline. `stooq` fetches real (delayed) quotes over the
# network from stooq.com — no API key needed, but it does need network.
QUOTE_PROVIDER=fake

# Seed mixed into the fake provider's per-symbol PRNG. Change it to get
# a different-looking but still-deterministic price series.
QUOTE_SEED=42

# Size, in milliseconds, of the time bucket the fake provider walks its
# random walk forward by. Smaller = prices change more often.
QUOTE_BUCKET_MS=5000

# --- Order simulator --------------------------------------------------

# When true, a background process submits random orders against the
# order book so the ladder and chat/portfolio views have visible
# activity without any manual trading. Off entirely disables it.
SIMULATOR_ENABLED=true

# Comma-separated list of stock symbols the simulator trades.
SIMULATOR_SYMBOLS=NOCK1,NOCK2,NOCK3,NOCK4,NOCK5

# Bounds, in milliseconds, of the random delay between simulated
# orders. Each cycle waits a random duration in [MIN, MAX] before
# submitting the next order.
SIMULATOR_MIN_MS=500
SIMULATOR_MAX_MS=3000
