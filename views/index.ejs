<!doctype html>
<html lang="en">
  <%- include('partials/head', { title: 'Nockmarket', extraStylesheets: ['/stylesheets/index.css'] }) %>
  <body>
    <header class="container">
      <nav>
        <ul>
          <li><strong>Nockmarket</strong></li>
        </ul>
        <ul>
          <li><button type="button" class="secondary" data-open-dialog="login-dialog">Log In</button></li>
          <li><button type="button" data-open-dialog="signup-dialog">Sign Up</button></li>
        </ul>
      </nav>
    </header>

    <main class="container">
      <hgroup class="hero">
        <h1>Nockmarket</h1>
        <p>Welcome to the Node.js stockmarket</p>
      </hgroup>

      <section class="grid">
        <article>
          <h2>Real Prices</h2>
          <p>
            Sign up for an account and build a stock portfolio with live prices, streamed to your
            browser as they change.
          </p>
        </article>
        <article>
          <h2>Live Data</h2>
          <p>
            A simulated exchange streams order-book updates and trades over a websocket, alongside
            a live chat with everyone else watching the market.
          </p>
        </article>
      </section>
    </main>

    <dialog id="login-dialog">
      <article>
        <header>
          <button aria-label="Close" rel="prev" type="button" data-close-dialog></button>
          <p><strong>Log In</strong></p>
        </header>
        <form id="login-form" method="post" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="login-username">Username</label>
          <input
            id="login-username"
            type="text"
            name="username"
            autocomplete="username"
            required
          />
          <label for="login-password">Password</label>
          <input
            id="login-password"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          />
          <p id="login-errors" class="form-errors" role="alert"></p>
          <button type="submit">Log In</button>
        </form>
      </article>
    </dialog>

    <dialog id="signup-dialog">
      <article>
        <header>
          <button aria-label="Close" rel="prev" type="button" data-close-dialog></button>
          <p><strong>Sign Up Today</strong></p>
        </header>
        <form id="signup-form" method="post" action="/signup">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label for="signup-username">Username</label>
          <input
            id="signup-username"
            type="text"
            name="username"
            autocomplete="username"
            required
          />
          <small id="username-availability"></small>
          <label for="signup-email">Email</label>
          <input id="signup-email" type="email" name="email" autocomplete="email" required />
          <label for="signup-password">Password</label>
          <input
            id="signup-password"
            type="password"
            name="password"
            autocomplete="new-password"
            required
          />
          <label for="signup-password-confirm">Confirm Password</label>
          <input
            id="signup-password-confirm"
            type="password"
            name="passwordConfirm"
            autocomplete="new-password"
            required
          />
          <p id="signup-errors" class="form-errors" role="alert"></p>
          <button type="submit" id="signup-submit" disabled>Create Account</button>
        </form>
      </article>
    </dialog>

    <script type="module" src="/js/index.js"></script>
  </body>
</html>
